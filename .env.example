PORT=5000
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/expense_tracker


# For MongoDB Atlas, copy the URI from Atlas > Connect > Drivers and replace
# the MONGO_URI value above in your private .env file. The URI uses an Atlas
# database username/password, not your Atlas sign-in email.
# Example format (replace every placeholder):
# MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/expense_tracker?retryWrites=true&w=majority
# Add your current IP in Atlas Network Access. Never share or commit your real URI.
