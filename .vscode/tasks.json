{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Expense Tracker API",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["start"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "expense-tracker",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> node server\\.js",
          "endsPattern": "^(Server running on http://localhost:5000|MongoDB connection failed:)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
